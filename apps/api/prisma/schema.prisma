generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DIRECTOR
  SUPER_ADMIN
  STAFF
}

enum TaskFrequency {
  DAILY
  WEEKLY
}

enum TaskStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReviewQuality {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ReviewSource {
  QR
  WEBSITE
  INSTAGRAM
  VERBAL
  OTHER
}

enum NotificationType {
  REMINDER
  ALERT
  AI_REPORT
  STOCK
  SCORE
  MYSTERY
  SYSTEM
}

enum AiReportType {
  SERVICES
  CALLS
}

enum KpiInputType {
  GROUP
  CHECKBOX
  RATIO
  NUMBER
  NOTE_CHECK
}

enum AiProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KpiFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AiAction {
  NONE
  RESUBMIT
  WARN
  PENALTY
}

model Position {
  id        String   @id @default(cuid())
  code      String   @unique
  nameUz    String
  nameRu    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  taskTemplates TaskTemplate[]

  @@index([active, sortOrder])
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(ADMIN)
  positionId   String?
  phone        String?
  avatarUrl    String?
  bio          String?
  telegramId   String?        @unique
  branchId     String?
  active       Boolean        @default(true)
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  branch          Branch?               @relation(fields: [branchId], references: [id])
  positionRef     Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]
  notifications   Notification[]
  dailyClinic     DailyClinicCheck[]
  receptionChecks ReceptionCheck[]
  uniformChecks   UniformCheck[]
  warehouseChecks WarehouseCheck[]
  callEntries     CallEntry[]
  reviews         Review[]
  seoChecks       SeoCheck[]
  adsChecks       AdsCheck[]
  flyerEntries    FlyerEntry[]
  bloggerEntries  BloggerEntry[]
  doctorStories   DoctorStory[]
  doctorReferrals DoctorReferral[]
  mysteryTests    MysteryPatientTest[]
  dailyTasks      DailyTask[]           @relation("TaskAssignee")
  reviewedTasks   DailyTask[]           @relation("TaskReviewer")
  monthlyScores   MonthlyEmployeeScore[]
  taskTemplates   TaskTemplate[]
  managedBranches BranchManager[]
  kpiEntries      KpiDayEntry[]
  kpiProofs       KpiProof[]
  kpiAssignments  KpiTaskAssignment[]
  kpiTemplates    KpiAssignmentTemplate[]
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  doctors         Doctor[]
  products        WarehouseProduct[]
  managers        BranchManager[]
  kpiEntries      KpiDayEntry[]
  dailyScores     DailyScore[]
  kpiAssignments  KpiTaskAssignment[]
  kpiTemplates    KpiAssignmentTemplate[]
}

model BranchManager {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([userId])
}

model KpiCatalogNode {
  id          String       @id @default(cuid())
  key         String       @unique
  parentKey   String?
  titleUz     String
  titleRu     String
  descriptionUz String?
  descriptionRu String?
  inputType   KpiInputType
  frequency   KpiFrequency @default(DAILY)
  weight      Float        @default(0)
  sortOrder   Int          @default(0)
  proofRequired Boolean    @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentKey, sortOrder])
  @@index([active, sortOrder])
  @@index([frequency, active])
}

model KpiDayEntry {
  id        String   @id @default(cuid())
  branchId  String
  date      DateTime @db.Date
  nodeKey   String
  value     Json?
  done      Boolean  @default(false)
  score     Float?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  proofs KpiProof[]

  @@unique([branchId, date, nodeKey])
  @@index([branchId, date])
  @@index([nodeKey])
}

model KpiTaskAssignment {
  id           String       @id @default(cuid())
  branchId     String
  date         DateTime     @db.Date
  frequency    KpiFrequency
  nodeKey      String
  assignedById String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([branchId, date, nodeKey])
  @@index([branchId, date, frequency])
  @@index([assignedById])
}

/** Doimiy topshiriq shabloni — sana emas, chastota boʻyicha (kunlik/haftalik/oylik) */
model KpiAssignmentTemplate {
  id           String       @id @default(cuid())
  branchId     String
  frequency    KpiFrequency
  nodeKey      String
  assignedById String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([branchId, frequency, nodeKey])
  @@index([branchId, frequency, active])
  @@index([assignedById])
}

model KpiProof {
  id         String        @id @default(cuid())
  entryId    String
  userId     String
  fileName   String
  mimeType   String
  path       String
  size       Int
  aiStatus   AiProofStatus @default(PENDING)
  aiNote     String?
  aiFeedback String?
  aiAction   AiAction      @default(NONE)
  aiPenalty  Float         @default(0)
  createdAt  DateTime      @default(now())

  entry KpiDayEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, aiStatus])
}

model Doctor {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  active    Boolean  @default(true)
  branchId  String?
  createdAt DateTime @default(now())

  branch    Branch?           @relation(fields: [branchId], references: [id])
  stories   DoctorStory[]
  referrals DoctorReferral[]
}

model DailyClinicCheck {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  items      Json
  percentage Float
  adminId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model ReceptionCheck {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  items      Json
  percentage Float
  adminId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model UniformCheck {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  items      Json
  percentage Float
  adminId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model WarehouseCheck {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  items        Json
  percentage   Float
  minStockFlag Boolean  @default(false)
  adminId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model WarehouseProduct {
  id           String    @id @default(cuid())
  name         String
  category     String
  minStock     Int       @default(10)
  currentStock Int       @default(0)
  expiryDate   DateTime? @db.Date
  branchId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])
}

enum CallType {
  NEW
  REPEAT
  MISSED
}

model CallEntry {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  type          CallType
  callsCount    Int      @default(0)
  bookedCount   Int      @default(0)
  recalledCount Int?     @default(0)
  conversion    Float    @default(0)
  adminId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date, type])
  @@index([date])
}

model Review {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  count     Int           @default(1)
  source    ReviewSource  @default(QR)
  quality   ReviewQuality @default(POSITIVE)
  note      String?
  adminId   String
  createdAt DateTime      @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([date])
}

model SeoCheck {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  newArticle     Boolean  @default(false)
  newVideo       Boolean  @default(false)
  newReviews     Boolean  @default(false)
  pageUpdated    Boolean  @default(false)
  seoOk          Boolean  @default(false)
  pagespeedScore Float?
  note           String?
  adminId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model SocialStats {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  platform      String
  posts         Int      @default(0)
  stories       Int      @default(0)
  reels         Int      @default(0)
  comments      Int      @default(0)
  likes         Int      @default(0)
  newFollowers  Int      @default(0)
  views         Int      @default(0)
  source        String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, platform])
  @@index([date])
}

model AdsCheck {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  aired     Boolean  @default(false)
  channel   String?
  timeSlot  String?
  note      String?
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model FlyerEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int
  location  String
  adminId   String
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([date])
}

model BloggerEntry {
  id         String   @id @default(cuid())
  weekStart  DateTime @db.Date
  name       String
  followers  Int
  niche      String?
  contact    String?
  note       String?
  adminId    String
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([weekStart])
}

model DoctorStory {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  doctorId  String
  posted    Boolean  @default(false)
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])
  admin  User   @relation(fields: [adminId], references: [id])

  @@unique([date, doctorId])
  @@index([date])
}

model DoctorReferral {
  id           String   @id @default(cuid())
  weekStart    DateTime @db.Date
  doctorId     String
  patientsCount Int     @default(0)
  adminId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])
  admin  User   @relation(fields: [adminId], references: [id])

  @@unique([weekStart, doctorId])
  @@index([weekStart])
}

model MysteryPatientTest {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  booked    Boolean
  note      String?
  adminId   String
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@unique([date])
  @@index([date])
}

model AiWeeklyReport {
  id         String       @id @default(cuid())
  weekStart  DateTime     @db.Date
  periodEnd  DateTime?    @db.Date
  period     String       @default("WEEK")
  type       AiReportType
  content    String
  createdAt  DateTime     @default(now())

  @@unique([weekStart, type, period])
  @@index([weekStart])
  @@index([period, weekStart])
}

model KpiWeight {
  id        String   @id @default(cuid())
  blockKey  String   @unique
  blockName String
  weight    Float
  frequency String
  updatedAt DateTime @updatedAt
}

model DailyScore {
  id          String   @id @default(cuid())
  branchId    String?
  date        DateTime @db.Date
  totalScore  Float
  blockScores Json
  completion  Json?
  colorStatus String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
  @@index([branchId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date @unique
  title     String
  createdAt DateTime @default(now())

  @@index([date])
}

model TaskTemplate {
  id            String         @id @default(cuid())
  userId        String?
  positionId    String
  title         String
  description   String
  proofRequired Boolean        @default(true)
  weight        Float          @default(10)
  frequency     TaskFrequency  @default(DAILY)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position  @relation(fields: [positionId], references: [id])
  tasks    DailyTask[]

  @@index([userId, active])
  @@index([positionId, active])
}

model DailyTask {
  id            String     @id @default(cuid())
  userId        String
  templateId    String?
  date          DateTime   @db.Date
  title         String
  description   String
  proofRequired Boolean    @default(true)
  weight        Float      @default(10)
  status        TaskStatus @default(PENDING)
  employeeNote  String?
  reviewerNote  String?
  reviewedById  String?
  submittedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user       User          @relation("TaskAssignee", fields: [userId], references: [id])
  reviewer   User?         @relation("TaskReviewer", fields: [reviewedById], references: [id])
  template   TaskTemplate? @relation(fields: [templateId], references: [id])
  proofs     TaskProof[]

  @@unique([userId, date, templateId])
  @@index([date, status])
  @@index([userId, date])
}

model TaskProof {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())

  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model MonthlyEmployeeScore {
  id         String   @id @default(cuid())
  userId     String
  year       Int
  month      Int
  totalScore Float
  breakdown  Json
  aiSummary  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([year, month])
}

model StaffMonthlyReport {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}
