# Copy to .env and fill ALL values before docker compose up
# Generate JWT: openssl rand -base64 48

POSTGRES_USER=klinikpi
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=klinikpi

# Min 32 chars, random — NEVER use defaults in production
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-domain.uz
NEXT_PUBLIC_DEMO=false

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seed: productionda faqat birinchi deploy uchun ALLOW_INITIAL_SEED=true
ALLOW_INITIAL_SEED=false
SEED_WIPE=false
SEED_ON_START=false
